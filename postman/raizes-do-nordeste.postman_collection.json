          "name": "T12 [Sucesso] Criar usuário com Perfil Atendente",
          "event": [
		  	{
			  "listen": "prerequest",
			  "script": {
				"exec": [
				  "    console.warn(\"⚠️ [ATENÇÃO] Este teste depende do 'Login do Administrador (T05)'. Certifique-se de executá-lo primeiro!\");"
				],
				"type": "javascript"
			  }
			},
            {
              "listen": "test",
              "script": {
				"exec": [
				  "pm.test(\"Criado com sucesso (Requer cargo: Administrador ou Gerente da Unidade)\", function () {",
				  "    if (pm.response.code === 201) {",
				  "        pm.response.to.have.status(201);",
				  "    }",
				  "});",
				  "",
				  "pm.test(\"Retorna 422 se o usuário não for Gerente da unidade ou Administrador, ou se violar regras do escopo\", function () {",
				  "    if (pm.response.code === 422) {",
				  "        pm.response.to.have.status(422);",
				  "        var jsonData = pm.response.json();",
				  "        ",
				  "        // Valida se a mensagem de erro detalha a restrição de cargo do edital",
				  "        pm.expect(jsonData.error).to.be.oneOf([\"ACESSO_NEGADO\", \"REGRA_NEGOCIO_VIOLADA\", \"REQUEST_INVALIDO\"]);",
				  "        pm.expect(jsonData.message).to.match(/(gerente|administrador|permissão|cargo)/i);",
				  "    }",
				  "});"
				],
                "type": "javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_jwt}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Severino dos Santos\",\n  \"email\": \"severino.atendimento@raizesdonordeste.com\",\n  \"senha\": \"SenhaAtendente@123\",\n  \"perfil\": 2,\n  \"unidadeId\": 1,\n  \"consentimentoLgpd\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/usuarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          }
        },
		{
		  "name": "T13 [Sucesso] LGPD - Anonimização de Usuário",
		  "event": [
			{
			  "listen": "prerequest",
			  "script": {
				"exec": [
				  "    console.warn(\"⚠️ [ATENÇÃO] Este teste depende do 'Login Cliente B (T02) ou do Administrador (T05)'. Certifique-se de executá-lo primeiro!\");"
				],
				"type": "javascript"
			  }
			},
			{
			  "listen": "test",
			  "script": {
				"exec": [
				  "pm.test(\"Validar resultado da exclusão definitiva (LGPD)\", function () {",
				  "    pm.expect(pm.response.code).to.be.oneOf([200, 401, 404]);",
				  "    ",
				  "    var jsonData = pm.response.json();",
				  "    ",
				  "    if (pm.response.code === 200) {",
				  "        pm.response.to.have.status(200);",
				  "        pm.expect(jsonData.message).to.include(\"Cliente anonimado por LGPD\");",
				  "        pm.expect(jsonData.path).to.not.be.undefined;",
				  "    } ",
				  "    else if (pm.response.code === 404) {",
				  "        pm.response.to.have.status(404);",
				  "        pm.expect(jsonData.error).to.eql(\"USUARIO_INEXISTENTE\");",
				  "        pm.expect(jsonData.message).to.eql(\"Usuário não encontrado ou operação negada.\");",
				  "    } ",
				  "    else if (pm.response.code === 401) {",
				  "        pm.response.to.have.status(401);",
				  "        pm.expect(jsonData.error).to.eql(\"CREDENCIAIS_INVALIDAS\");",
				  "    }",
				  "});"
				],
				"type": "javascript"
			  }
			}
		  ],
		  "request": {
			"auth": {
			  "type": "bearer",
			  "bearer": [
				{
				  "key": "token",
				  "value": "{{token_jwt}}",
				  "type": "string"
				}
			  ]
