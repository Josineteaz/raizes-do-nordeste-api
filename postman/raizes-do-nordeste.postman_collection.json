	{
	  "name": "Pagamentos",
	  "item": [
		{
		  "name": "T11 [Sucesso] Simular Pagamento",
			"event": [
				{
				  "listen": "prerequest",
				  "script": {
					"exec": [
					  "    console.warn(\"⚠️ [ATENÇÃO] Este teste depende do 'Login Cliente A (T01)'. Certifique-se de executá-lo primeiro!\");"
					],
					"type": "javascript"
				  }
				},
			  {
				"listen": "test",
				"script": {
				  "exec": [
					"pm.test(\"Validar pagamento processado ou cenário de conflito\", function () {",
					"    pm.expect(pm.response.code).to.be.oneOf([200, 409]);",
					"    ",
					"    var jsonData = pm.response.json();",
					"    ",
					"    if (pm.response.code === 200) {",
					"        pm.response.to.have.status(200);",
					"        pm.expect(jsonData.sucesso).to.be.true;",
					"        pm.expect(jsonData.pedidoId).to.be.a(\"number\");",
					"        pm.expect(jsonData.mensagem).to.not.be.null;",
					"    } else if (pm.response.code === 409) {",
					"        pm.response.to.have.status(409);",
					"        pm.expect(jsonData.error).to.eql(\"STATUS_CONFLITO\");",
					"        pm.expect(jsonData.message).to.include(\"cancelado anteriormente.\");",
					"        pm.expect(jsonData.timestamp).to.not.be.undefined;",
					"    }",
					"});"
				  ],
				  "type": "javascript"
				}
			  }
			],
		  "request": {
			"auth": {
			  "type": "bearer",
			  "bearer": [
				{
				  "key": "token",
				  "value": "{{token_jwt}}",
				  "type": "string"
				}
			  ]
			},
			"method": "POST",
			"header": [
			  {
				"key": "Content-Type",
				"value": "application/json"
			  }
			],
			"body": {
			  "mode": "raw",
			  "raw": "{\n  \"pedidoId\": 1,\n  \"status\": 2 \n}"
			},
			"url": {
			  "raw": "{{base_url}}/pagamentos/simular",
			  "host": [
				"{{base_url}}"
			  ],
			  "path": [
				"pagamentos",
				"simular"
			  ]
			}
		  }
		}
	  ]
