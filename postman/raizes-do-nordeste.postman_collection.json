				{
		  "name": "T08 [Sucesso] Mudar Status do Pedido em EmPreparo",
		  "event": [
		  	{
			  "listen": "prerequest",
			  "script": {
				"exec": [
				  "    console.warn(\"⚠️ [ATENÇÃO] Este teste depende do 'Login do Cozinheiro da Unidade B (T03)'. Certifique-se de executá-lo primeiro!\");"
				],
				"type": "javascript"
			  }
			},
			{
			  "listen": "test",
			  "script": {
				"exec": [
				  "var idPedido = pm.collectionVariables.get(\"pedido_id_recente\");",
				  "pm.expect(pm.response.code).to.be.oneOf([200, 422]);",
				  "",
				  "if (pm.response.code === 200) {",
				  "    pm.test(`Status do pedido nº ${idPedido} alterado de Pago para EmPreparo`, function () {",
				  "        pm.response.to.have.status(200);",
				  "    });",
				  "} else if (pm.response.code === 422) {",
				  "    pm.test(`O pedido já se encontra no status 'EmPreparo'. Nenhuma transição foi realizada.`, function () {",
				  "        pm.response.to.have.status(422);",
				  "        var jsonData = pm.response.json();",
				  "        pm.expect(jsonData.error).to.eql(\"REGRA_NEGOCIO_VIOLADA\");",
				  "    });",
				  "}"
				],
				"type": "javascript"
			  }
			}
		  ],
		  "request": {
			"auth": {
			  "type": "bearer",
			  "bearer": [{ "key": "token", "value": "{{token_jwt}}", "type": "string" }]
			},
			"method": "PATCH",
			"header": [{ "key": "Content-Type", "value": "application/json" }],
			"body": { "mode": "raw", "raw": "{\n  \"novoStatus\": 3\n}" },
			"url": {
			  "raw": "{{base_url}}/pedidos/{{pedido_id_recente}}/status",
			  "host": ["{{base_url}}"],
			  "path": ["pedidos", "{{pedido_id_recente}}", "status"]
			}
		  }
		},
